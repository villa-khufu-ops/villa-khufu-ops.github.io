rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.active == true;
    }
    function role() { return staffDoc().data.role; }
    function isAdmin() { return isStaff() && role() == 'admin'; }
    function hasRole(rs) { return isStaff() && role() in rs; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }
    // which fields this update changes
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyKeys(ks) { return changed().hasOnly(ks); }
    function same(k) { return !(k in changed()); }
    function byMe() { return request.resource.data.by == request.auth.uid; }

    // تعرف الصفحة منه إذا كان أول تشغيل ولا لأ
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /staff/{uid} {
      allow read: if isStaff();
      // أول مدير بيسجّل نفسه مرة واحدة بس، وقت الإعداد
      allow create: if (signedIn() && request.auth.uid == uid && !setupDone()
                        && getAfter(/databases/$(database)/documents/meta/setup) != null
                        && request.resource.data.role == 'admin')
                    || isAdmin();
      // المدير يعدّل أي حساب · الموظف يغيّر اسمه بس
      allow update: if isAdmin()
        || (isStaff() && request.auth.uid == uid && onlyKeys(['name']));
      allow delete: if isAdmin();
    }

    // الغرف: المدير والريسبشن ومدير وسوبر فايزر الهاوس كيبنج كل حاجة ·
    // العاملة مهمتها بس (أو توقف الغرفة صيانة) · الفني يرجّع الغرفة بعد التصليح
    match /rooms/{no} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || hasRole(['rec', 'hkm', 'hks', 'shiftm'])
        || (hasRole(['hk']) && onlyKeys(['task', 'status'])
            && (same('status') || request.resource.data.status == 'maint')
            && (same('task') || (request.resource.data.task is map
                                 && request.resource.data.task.w == request.auth.uid)))
        || (hasRole(['mnt']) && onlyKeys(['status'])
            && request.resource.data.status in ['clean', 'maint']);
      allow delete: if false;
    }

    match /maint/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && byMe();
      allow update: if isAdmin()
        || (hasRole(['rec', 'hkm', 'hks', 'mnt', 'shiftm'])
            && onlyKeys(['open', 'fixedAt', 'fixedBy', 'ackAt', 'ackBy', 'next']));
      allow delete: if isAdmin();
    }

    // سجل الحركة للتقارير: كل موظف يضيف باسمه بس، والمدير بس يعدّل أو يمسح
    match /log/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && byMe();
      allow update, delete: if isAdmin();
    }

    // طلبات المطعم والتلاجة
    match /orders/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && byMe();
      allow update: if isAdmin()
        // الريسبشن: التحصيل · نقل الحساب · التقديم · إلغاء قبل ما المطبخ يستلم
        || (hasRole(['rec', 'shiftm'])
            && onlyKeys(['paid', 'paidAt', 'paidBy', 'room', 'st', 'servedAt', 'servedBy', 'cancelAt', 'cancelBy'])
            && (same('st') || request.resource.data.st == 'served'
                || (resource.data.st == 'new' && request.resource.data.st == 'cancel')))
        // مدير المطعم: المطبخ والتقديم والإلغاء في أي وقت
        || (hasRole(['restm', 'shiftm'])
            && onlyKeys(['st', 'ackAt', 'ackBy', 'next', 'readyAt', 'servedAt', 'servedBy', 'cancelAt', 'cancelBy', 'paid']))
        // الويتر: التقديم · إلغاء قبل ما المطبخ يستلم
        || (hasRole(['rest'])
            && onlyKeys(['st', 'servedAt', 'servedBy', 'cancelAt', 'cancelBy', 'paid'])
            && (request.resource.data.st == 'served'
                || (resource.data.st == 'new' && request.resource.data.st == 'cancel')))
        // المطبخ: استلام وجاهز بس
        || (hasRole(['kit'])
            && onlyKeys(['st', 'ackAt', 'ackBy', 'next', 'readyAt'])
            && request.resource.data.st in ['prep', 'ready']);
      allow delete: if isAdmin();
    }

    // فواتير المغسلة
    match /laundry/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && byMe();
      allow update: if isAdmin()
        || (hasRole(['rec', 'shiftm'])
            && onlyKeys(['paid', 'paidAt', 'paidBy', 'room', 'st', 'ackAt', 'ackBy', 'readyAt', 'doneAt', 'doneBy', 'cancelAt', 'cancelBy']))
        || (hasRole(['lnd', 'hkm', 'hks', 'hk', 'shiftm'])
            && onlyKeys(['st', 'ackAt', 'ackBy', 'readyAt', 'doneAt', 'doneBy', 'cancelAt', 'cancelBy', 'paid'])
            && (same('paid') || (resource.data.st == 'new' && request.resource.data.st == 'cancel')));
      allow delete: if isAdmin();
    }

    // حاجات لازم الريسبشن يسجّلها على Aiosell
    match /aio/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && byMe();
      allow update: if isAdmin() || (hasRole(['rec', 'shiftm']) && onlyKeys(['done', 'doneAt', 'doneBy']));
      allow delete: if isAdmin();
    }

    // المفقودات
    match /lost/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && byMe();
      allow update: if isAdmin() || (hasRole(['rec', 'hkm', 'hks', 'shiftm']) && onlyKeys(['st', 'retAt', 'retBy']));
      allow delete: if isAdmin();
    }

    // تجهيز شغل بكرة: توزيع الهاوس كيبنج ووصول بكرة من Aiosell
    match /prep/{day} {
      allow read: if isStaff();
      allow create, update: if hasRole(['admin', 'hkm', 'hks', 'shiftm']);
      allow delete: if isAdmin();
    }

    // طلبات النزلاء من الـ QR: أي حد يبعت طلب لغرفة مشغولة بس، والريسبشن والمدير بس اللي يشوفوها ويردّوا عليها
    match /greq/{id} {
      allow create: if request.resource.data.keys().hasOnly(['room', 'type', 'items', 'tour', 'note', 'at', 'st'])
        && request.resource.data.room is string && request.resource.data.room.size() == 3
        && request.resource.data.type in ['food', 'tour']
        && request.resource.data.st == 'new'
        && request.resource.data.at is number
        && request.resource.data.items is list && request.resource.data.items.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.room)).data.status == 'occ';
      allow read: if hasRole(['admin', 'rec', 'shiftm']);
      allow update: if hasRole(['admin', 'rec', 'shiftm']) && onlyKeys(['st', 'doneAt', 'doneBy']);
      allow delete: if isAdmin();
    }

    // شات النزلاء: كل محادثة ليها رقم سري عشوائي هو اللي بيفتحها، والريسبشن والمدير بيشوفوا الكل
    match /chats/{tid} {
      allow get: if true;
      allow list: if hasRole(['admin', 'rec', 'shiftm']);
      allow create: if tid.size() >= 20
        && request.resource.data.keys().hasOnly(['room', 'at', 'last', 'lastFrom', 'lastText', 'open', 'unread'])
        && request.resource.data.room is string && request.resource.data.room.size() == 3
        && request.resource.data.lastFrom == 'guest' && request.resource.data.open == true
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 80
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.room)).data.status == 'occ';
      allow update: if hasRole(['admin', 'rec', 'shiftm'])
        || (onlyKeys(['last', 'lastFrom', 'lastText', 'open', 'unread'])
            && request.resource.data.lastFrom == 'guest' && request.resource.data.open == true
            && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 80);
      allow delete: if isAdmin();
      match /msgs/{m} {
        allow read: if true;
        allow create: if existsAfter(/databases/$(database)/documents/chats/$(tid))
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.at is number
          && ((request.resource.data.from == 'guest' && request.resource.data.keys().hasOnly(['from', 'text', 'at']))
              || (request.resource.data.from == 'rec' && hasRole(['admin', 'rec', 'shiftm']) && request.resource.data.by == request.auth.uid));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // تسليم الشيفت
    match /shift/{id} {
      allow read: if hasRole(['admin', 'rec', 'shiftm']);
      allow create: if hasRole(['admin', 'rec', 'shiftm']) && byMe();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // أجهزة الإشعارات: كل موظف يسجّل جهازه باسمه ووظيفته بس، والمدير يشوفهم
    match /push/{tok} {
      allow read: if isAdmin();
      allow create, update: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == role()
        && request.resource.data.keys().hasOnly(['uid', 'role', 'at', 'ua']);
      allow delete: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
    }

    // الحضور والانصراف التلقائي بالموقع: كل موظف يسجل لنفسه بس، والمدير ومدير وسوبر فايزر الهاوس كيبنج يشوفوا الحضور
    match /att/{id} {
      allow read: if hasRole(['admin', 'hkm', 'hks', 'shiftm']) || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid
        && request.resource.data.st == 'open'
        && request.resource.data.keys().hasOnly(['uid', 'd', 'inAt', 'lastAt', 'inLat', 'inLng', 'inAcc', 'st'])
        && request.resource.data.inAt is number
        && request.resource.data.inAt > request.time.toMillis() - 300000
        && request.resource.data.inAt < request.time.toMillis() + 300000;
      allow update: if isAdmin()
        || (isStaff() && resource.data.uid == request.auth.uid && resource.data.st == 'open'
            && onlyKeys(['lastAt', 'lastLat', 'lastLng', 'lastAcc', 'outAt', 'outLat', 'outLng', 'outAcc', 'st', 'auto'])
            && (
              (request.resource.data.st == 'open'
                && request.resource.data.lastAt is number
                && request.resource.data.lastAt > request.time.toMillis() - 300000
                && request.resource.data.lastAt < request.time.toMillis() + 300000)
              || (request.resource.data.st == 'closed'
                && request.resource.data.outAt is number
                && request.resource.data.outAt >= resource.data.inAt
                && request.resource.data.outAt < request.time.toMillis() + 300000)
            ));
      allow delete: if isAdmin();
    }

    // مكان الفندق للحضور: المدير بس يحدده
    match /geo/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // سجل أخطاء الأبلكيشن: أي موظف يسجّل خطأ حصل عنده، والمدير بس يشوف ويمسح
    // المرتب: المدير بس يكتبه · كل موظف يشوف مرتبه هو بس
    match /pay/{uid} {
      allow read: if isAdmin() || (isStaff() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // الجزاءات والإضافي: المدير بس يسجلها · الموظف يشوف بتاعته بس
    // الإضافي والجزاءات: المدير لكل الناس · مديرة الهاوس كيبنج لفريقها · مدير المطعم للمطعم والمطبخ
    // الموظف يشوف بتاعته بس · المدير اللي سجّل يشوف ويمسح اللي سجّله
    function teamRole(uid) { return get(/databases/$(database)/documents/staff/$(uid)).data.role; }
    function myTeam(uid) {
      return (hasRole(['hkm']) && teamRole(uid) in ['hk', 'hks'])
          || (hasRole(['restm']) && teamRole(uid) in ['rest', 'kit']);
    }
    match /adj/{id} {
      allow read: if isAdmin()
        || (isStaff() && (resource.data.uid == request.auth.uid || resource.data.by == request.auth.uid));
      allow create: if byMe()
        && (isAdmin() || myTeam(request.resource.data.uid))
        && request.resource.data.uid != request.auth.uid
        && request.resource.data.type in ['pen', 'add']
        && request.resource.data.amt is number && request.resource.data.amt > 0;
      allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
    }

    match /errs/{id} {
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // المصاريف: الريسبشن والمديرين والمحاسب بيدخلوها · المحاسب يراجع · المدير يوافق بعد المراجعة
    match /exp/{id} {
      allow read: if hasRole(['admin', 'acc']) || (isStaff() && (resource.data.by == request.auth.uid || resource.data.get('emp', '') == request.auth.uid));
      allow create: if hasRole(['admin', 'rec', 'hkm', 'restm', 'acc', 'shiftm']) && byMe()
        && request.resource.data.st == 'new'
        && request.resource.data.amt is number && request.resource.data.amt > 0
        && request.resource.data.cat in ['fixed', 'var', 'tour', 'adv', 'buy'];
      allow update: if
        (hasRole(['acc']) && resource.data.st == 'new'
          && onlyKeys(['st', 'chkBy', 'chkAt', 'rejBy', 'rejAt', 'rejWhy'])
          && request.resource.data.st in ['checked', 'rej'])
        || (isAdmin()
          && onlyKeys(['st', 'okBy', 'okAt', 'rejBy', 'rejAt', 'rejWhy'])
          && ((request.resource.data.st == 'ok' && resource.data.st == 'checked')
              || request.resource.data.st == 'rej'));
      allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid && resource.data.st == 'new');
    }
  }
}
